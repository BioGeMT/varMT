# Copy to .env and set real values
POSTGRES_PASSWORD=change-me
VARMT_PORT=8502

KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_PORT=8180
# Address browsers open Keycloak at
KEYCLOAK_URL=http://localhost:8180

# Shared secret between VarMT and Keycloak (generate with: openssl rand -hex 32)
VARMT_CLIENT_SECRET=change-me
# Address users open VarMT at; Keycloak only redirects back here after login
VARMT_URL=http://localhost:8502
# Signs the VarMT login cookie (generate with: openssl rand -hex 32)
VARMT_COOKIE_SECRET=change-me

# Mail server Keycloak sends verification emails through
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_FROM=no-reply@example.org
SMTP_STARTTLS=true
SMTP_AUTH=true
SMTP_USER=change-me
SMTP_PASSWORD=change-me
